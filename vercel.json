{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "pnpm test --run && pnpm snapshot && pnpm build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "functions": {
    "api/og.tsx": {
      "includeFiles": "{public/data/index.json,node_modules/@fontsource/geist/files/geist-latin-[46]00-normal.woff,node_modules/.pnpm/harfbuzzjs@*/node_modules/harfbuzzjs/hb.wasm}"
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
}
